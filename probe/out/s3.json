://www.tribunagrupo.com/#contacto","mostrar_contacto":"false","contacto_externo":"true","color_texto_boton":"#000000","numero_reportes_moderacion":"5","mostrar_radio":"false","is_registro_externo":"false","resizable":"false","mostrar_noticias24h":"false"},"app-home-nav-menu":{"bloque_activo":"true","mostrar_hemeroteca":"true","mostrar_blogs":"true","mostrar_revista":"true"},"app-logo-menu":{"color_fondo":"#0a4c76","bloque_activo":"true","bloque_tiempo":"true","textLogo":"El primer diario digital de Castilla y León","color_degradado":"#000333","fondo_degradado":"true","color_texto_logo":"#ffffff","mostrarLogo":"true","imagen_derecha":"//tribuna.isquad.es/assets/images/home/r1ejh_logo-cyl-mapa.png","logo":"//tribuna.isquad.es/assets/images/home/q84net_tribunamosca.png","imagen_fondo_activo":"false"},"app-secondary-menu":{"color_fondo":"#282d38","color_texto":"#ffffff","bloque_activo":"true"},"app-bloque-carta-director":{"bloque_activo":"true","img_editorial":"//tribuna.isquad.es/assets/images/home/gdfhmr_banner-carta-director.webp","img_editorial_movil":"//tribuna.isquad.es/assets/images/home/evm724_banner-carta-director-movil.webp"},"app-home":{"config_orden_portada_seccion":"false","portada_reels_movil":"true","has_live_video":"false","faq_titulo":"Handball.net: Deine Plattform für Handball in Deutschland","faq_items":"[{\"titulo\":\" Handball.net: Deine Plattform für Handball in Deutschland\",\"texto\":\"Handball.net ist die digitale Plattform für Handball in Deutschland. Hier findest du Spielpläne, Ergebnisse, Tabellen, Liveticker, Statistiken, News, Livestreams und Videos ? von den Nationalteams über Profiligen bis zum Amateurhandball. Ob du deinem Verein folgst, Ergebnisse suchst, Spiele live verfolgen möchtest oder aktuelle Handball-News lesen willst: handball.net bündelt die wichtigsten Informationen an einem Ort. Mit ?Mein Handball? kannst du deine Favoriten speichern und deinen persönlichen Handball-Alltag noch einfacher organisieren.\"},{\"titulo\":\"Welche Ergebnisse und Spielpläne finde ich auf handball.net?\",\"texto\":\"Auf Handball.net findest du Spielpläne, Ergebnisse, Tabellen und Wettbewerbe aus dem Handball in Deutschland. Dazu gehören verfügbare Spieldaten aus unterschiedlichen Ligen, Altersklassen, Landesverbänden und Wettbewerben ? vom Amateurbereich bis zu ausgewählten Top-Wettbewerben.\\n\\nIm Spielkalender kannst du nach Spielen suchen, Termine prüfen und Ergebnisse verfolgen. Außerdem findest du Informationen zu Vereinen, Teams, Hallen, Wettbewerben und Statistiken. So behältst du den Überblick über den aktuellen Spielbetrieb und findest schnell heraus, wann und wo dein Team spielt.\"},{\"titulo\":\"Wie hilft mir ?Mein Handball? im Alltag?\",\"texto\":\"Mit ?Mein Handball? kannst du handball.net persönlicher nutzen. Du kannst Vereine, Teams und Wettbewerbe als Favoriten speichern und schneller auf die Inhalte zugreifen, die für dich besonders wichtig sind.\\n\\nSo findest du Spielpläne, Ergebnisse und relevante Updates einfacher wieder. Das ist hilfreich, wenn du selbst spielst, ein Team trainierst, dein Kind im Verein begleitest oder regelmäßig einem bestimmten Verein folgst.\"},{\"titulo\":\"Wo finde ich Livestreams, Videos und Highlights?\",\"texto\":\"Livestreams, Videos und Highlights findest du im Bereich ?Livestreams & Videos? auf handball.net. Dort kannst du ausgewählte Handballspiele live verfolgen, Highlights ansehen und wichtige Szenen oder Spielzusammenfassungen nachträglich abrufen.\\n\\nIm Livecenter erhältst du außerdem aktuelle Informationen zu laufenden Spielen. So kannst du Handball auch dann verfolgen, wenn du nicht selbst in der Halle bist.\"},{\"titulo\":\"Für wen ist handball.net besonders relevant?\",\"texto\":\"Handball.net richtet sich an alle, die Handball in Deutschland verfolgen oder aktiv mitgestalten. Dazu gehören Handballspieler, Trainer, Vereine, Eltern, Fans, Schiedsrichter sowie die interessierte Handball-Community. \\n\\nDie Plattform hilft dir, schnell die Informationen zu finden, die zu deiner Rolle passen ? von Spielplänen und Ergebnissen über News bis hin zu Livestreams, Vereinsinformationen und persönlichen Favoriten.\"}]"},"app-banner-app-mv":{"color_texto_uno":"#ffffff","color_texto_dos":"#ffffff","color_borde":"#ffffff","color_fondo":"#0a4b75","color_degradado":"#000434","bloque_activo":"true","fondo_degradado":"true","img_icono":"//tribuna.isquad.es/assets/images/home/5wy91q_descarga-tribuna.webp","url_android":"Enlace de android: https://play.google.com/store/search?q=handball.net&c=apps&hl=de","img_android":"//tribuna.isquad.es/assets/images/home/i53gr_Grupo_57.png","img_ios":"//tribuna.isquad.es/assets/images/home/m07c8n_Grupo_56.png","color_btn_cierre":"#ffffff","texto_uno":"Descarga la app de Grupo Tribuna","texto_dos":"y estarás más cerca de toda nuestra actualidad.","pop_up_movil":"false","pop_up_escritorio":"false","banner_mv":"false","banner_escritorio":"true","url_ios":"https://apps.apple.com/es/app/handball-net/id1582777457"},"app-newsletter":{"color_texto_uno":"#ffffff","color_texto_dos":"#ffffff","color_borde":"#000000","color_fondo_newsletter":"#0a4b75","color_degradado":"#000000","color_btn_cierre":"#000000","color_texto_boton":"#ffffff","color_boton":"#000434","fondo_degradado":"false","bloque_activo":"true","pop_up_movil":"false","pop_up_escritorio":"true","mostrar_rrss":"true","texto_uno":"NUESTRA NEWSLETTER","texto_boton":"SUSCRIBIRME","input_correo":"true","mostrar_newsletter":"true","texto_dos":"SÍGUENOS","url_facebook":"https://www.facebook.com/tribunasalamanca","text_placeholder_input":"Escribe tu email","color_fondo_links":"#000434","logo_footer":"//tribuna.isquad.es/assets/images/home/ynthza_tribuna-crop.png","link_quienes_somos":"https://www.tribunagrupo.com/#nosotros","link_nuestros_sites":"https://www.tribunagrupo.com/#sites","link_tienda":"https://latiendadetribuna.com/","texto_tienda":"La tienda de Tribuna","texto_revista":"Revista Más Tribuna","link_revista":"https://tribunavalladolid.com/