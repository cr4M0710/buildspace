link rel="modulepreload" href="chunk-6QIW6GLP.js"><link rel="modulepreload" href="chunk-7TTXMAEO.js"><link rel="modulepreload" href="chunk-AJ3AKBE3.js"><link rel="modulepreload" href="chunk-DLOYBKJQ.js"><link rel="modulepreload" href="chunk-4BW7EGQX.js"><script src="main-T4KCMBZD.js" type="module"></script><script id="serverApp-state" type="application/json">{"2937947537":{"b":{"success":true,"meta":{"request_id":"d61b485d-dc85-4ca9-aad9-9d9e72387a2a","timestamp":"2026-10-25T06:51:14+00:00"},"data":{"general":{"app-bloque-destacados":{"bloque_activo":"false","numero_noticias":"4","color_texto":"#000434","color_fondo":"#e7e7e7"},"app-common-menu-burguer":{"bloque_activo":"true","mostrar_menu":"true","mostrar_buscador":"true","mostrar_parte_central":"true","mostrar_login":"true","color_fondo":"#131722","info_central":"\u003Cdiv style=\"text-align: left; \" class=\"item avila\">","color_menu":"#094e78","color_texto_menu":"#ffffff","mostrar_buscador_movil":"false","mostrar_login_movil":"false","logo_menu_movil":"//tribuna.isquad.es/assets/images/home/4nppv7_mosca.png","color_fondo_movil":"#000434","url_contacto":"https://www.tribunagrupo.com/#contacto","mostrar_contacto":"false","contacto_externo":"true","color_texto_boton":"#000000","numero_reportes_moderacion":"5","mostrar_radio":"false","is_registro_externo":"false","resizable":"false","mostrar_noticias24h":"false"},"app-home-nav-menu":{"bloque_activo":"true","mostrar_hemeroteca":"true","mostrar_blogs":"true","mostrar_revista":"true"},"app-logo-menu":{"color_fondo":"#0a4c76","bloque_activo":"true","bloque_tiempo":"true","textLogo":"El primer diario digital de Castilla y León","color_degradado":"#000333","fondo_degradado":"true","color_texto_logo":"#ffffff","mostrarLogo":"true","imagen_derecha":"//tribuna.isquad.es/assets/images/home/r1ejh_logo-cyl-mapa.png","logo":"//tribuna.isquad.es/assets/images/home/q84net_tribunamosca.png","imagen_fondo_activo":"false"},"app-secondary-menu":{"color_fondo":"#282d38","color_texto":"#ffffff","bloque_activo":"true"},"app-bloque-carta-director":{"bloque_activo":"true","img_editorial":"//tribuna.isquad.es/assets/images/home/gdfhmr_banner-carta-director.webp","img_editorial_movil":"//tribuna.isquad.es/assets/images/home/evm724_banner-carta-director-movil.webp"},"app-home":{"config_orden_portada_seccion":"false","portada_reels_movil":"true","has_live_video":"false","faq_titulo":"Handball.net: Deine Plattform für Handball in Deutschland","faq_items":"[{\"titulo\":\" Handball.net: Deine Plattform für Handball in Deutschland\",\"texto\":\"Handball.net ist die digitale Plattform für Handball in Deutschland. Hier findest du Spielpläne, Ergebnisse, Tabellen, Liveticker, Statistiken, News, Livestreams und Videos ? von den Nationalteams über Profiligen bis zum Amateurhandball. Ob du deinem Verein folgst, Ergebnisse suchst, Spiele live verfolgen möchtest oder aktuelle Handball-News lesen willst: handball.net bündelt die wichtigsten Informationen an einem Ort. Mit ?Mein Handball? kannst du deine Favoriten speichern und deinen persönlichen Handball-Alltag noch einfacher organisieren.\"},{\"titulo\":\"Welche Ergebnisse und Spielpläne finde ich auf handball.net?\",\"texto\":\"Auf Handball.net findest du Spielpläne, Ergebnisse, Tabellen und Wettbewerbe aus dem Handball in Deutschland. Dazu gehören verfügbare Spieldaten aus unterschiedlichen Ligen, Altersklassen, Landesverbänden und Wettbewerben ? vom Amateurbereich bis zu ausgewählten Top-Wettbewerben.\\n\\nIm Spielkalender kannst du nach Spielen suchen, Termine prüfen und Ergebnisse verfolgen. Außerdem findest du Informationen zu Vereinen, Teams, Hallen, Wettbewerben und Statistiken. So behältst du den Überblick über den aktuellen Spielbetrieb und findest schnell heraus, wann und wo dein Team spielt.\"},{\"titulo\":\"Wie hilft mir ?Mein Handball? im Alltag?\",\"texto\":\"Mit ?Mein Handball? kannst du handball.net persönlicher nutzen. Du kannst Vereine, Teams und Wettbewerbe als Favoriten speichern und schneller auf die Inhalte zugreifen, die für dich besonders wichtig sind.\\n\\nSo findest du Spielpläne, Ergebnisse und relevante Updates einfacher wieder. Das ist hilfreich, wenn du selbst spielst, ein Team trainierst, dein Kind im Verein begleitest oder regelmäßig einem bestimmten Verein folgst.\"},{\"titulo\":\"Wo finde ich Livestreams, Videos und Highlights?\",\"texto\":\"Livestreams, Videos und Highlights findest du im Bereich ?Livestreams & Videos? auf handball.net. Dort kannst du ausgewählte Handballspiele live verfolgen, Highlights ansehen und wichtige Szenen oder Spielzusammenfassungen nachträglich abrufen.\\n\\nIm Livecenter erhältst du außerdem aktuelle Informationen zu laufenden Spielen. So kannst du Handball auch dann verfolgen, wenn du nicht selbst in der Halle bist.\"},{\"titulo\":\"Für wen ist handball.net besonders relevant?\",\"texto\":\"Handball.net richtet sich an alle, die Handball in Deutschland verfolgen oder aktiv mitgestalten. Dazu gehören Handballspieler, Trainer, Vereine, Eltern, Fans, Schiedsrichter sowie die interessierte Handball-Community. \\n\\nDie Plattform hilft dir, schnell die Informationen zu finden, die zu deiner Rolle passen ? von Spielplänen und Ergebnissen über News bis hin zu Livestreams, Vereinsinformationen und persönlichen Favoriten.\"}]"},"app-banner-app-mv":{"color_texto_uno":"#ffffff","color_texto_dos":"#ffffff","color_borde":"#ffffff","color_fondo":"#0a4b75","color_degradado":"#000434","bloque_activo":"true","fondo_degradado":"true","img_icono":"//tribuna.isquad.es/assets/images/home/5wy91q_descarga-tribuna.webp","url_android":"Enlace de android: https://play.google.com/store/search?q=handball.net&c=apps&hl=de","img_android":"//tribuna.isquad.es/assets/images/home/i53gr_Grupo_57.png","img_ios":"//tribuna.isquad.es/assets/images/home/m07c8n_Grupo_56.png","color_btn_cierre":"#ffffff","texto_uno":"Descarga la app de Grupo Tribuna","texto_dos":"y estarás más cerca de toda nuestra actualidad.","pop_up_movil":"false","pop_up_escrit