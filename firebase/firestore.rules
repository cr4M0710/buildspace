rules_version = '2';

// =====================================================================
// buildspace – Firestore-Sicherheitsregeln (Projekt kanban-board-281da)
// ---------------------------------------------------------------------
// Vollständige Regeln für ALLE Funktionen von buildspace. Einspielen:
// Firebase-Konsole › Firestore › Regeln › kompletten Inhalt ersetzen ›
// „Veröffentlichen“. Anleitung und Prüfliste: firebase/ANLEITUNG.md
//
// Grundsätze
// - Alles, was hier nicht ausdrücklich erlaubt ist, ist verboten.
// - „angemeldet()“ gilt auch für anonyme Sitzungen. Die bekommt JEDE
//   Besucherin automatisch – das ist also keine echte Hürde. Echte
//   Konten (Google) prüft „echtesKonto()“.
// - Lehrkräfte (Classroom Management) müssen von Marc freigeschaltet
//   sein (teachers/{uid}.status == "approved").
// - Codes (Schüler-Codes, Board-Codes) funktionieren wie Passwörter:
//   Einzelne Dokumente sind mit dem Code lesbar, Listen nie.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hilfsfunktionen ----------
    function angemeldet() { return request.auth != null; }
    function echtesKonto() {
      return angemeldet() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function istAdmin() {
      return echtesKonto()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'marcstroh11@googlemail.com';
    }
    function lehrkraftDoc() {
      return /databases/$(database)/documents/teachers/$(request.auth.uid);
    }
    function freigeschalteteLehrkraft() {
      return echtesKonto() && (istAdmin()
        || (exists(lehrkraftDoc()) && get(lehrkraftDoc()).data.status == 'approved'));
    }
    function neu() { return request.resource.data; }
    function alt() { return resource.data; }
    function nurFelder(felder) { return neu().keys().hasOnly(felder); }
    function geaendert() { return neu().diff(alt()).affectedKeys(); }
    function istText(v, max) { return v is string && v.size() <= max; }

    // =================================================================
    // Classroom Management (cm-auth.js, kurse-projekte.html,
    // lernbereich.html, kanban-board.html)
    // =================================================================

    // Warteliste/Freischaltung der Lehrkräfte. Niemand kann sich selbst
    // freischalten – nur Marc (Admin).
    match /teachers/{uid} {
      allow get: if angemeldet() && (request.auth.uid == uid || istAdmin());
      allow list: if istAdmin();
      allow create: if echtesKonto() && request.auth.uid == uid
        && nurFelder(['email', 'status', 'createdAt'])
        && neu().email == request.auth.token.email
        && (neu().status == 'pending' || (neu().status == 'approved' && istAdmin()));
      allow update, delete: if istAdmin();
    }

    // Klassen: nur die eigene Lehrkraft
    match /classes/{id} {
      allow read, update, delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
        && (request.method != 'update' || neu().ownerUid == alt().ownerUid);
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
    }

    // Lernende (nur Pseudonyme). Lernende melden sich mit ihrem Code an
    // (= Dokument-ID) und dürfen genau dieses eine Dokument lesen.
    match /students/{code} {
      allow get: if true;  // Lernbereich liest ohne Anmeldung
      allow list: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
      allow update: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
        && neu().ownerUid == request.auth.uid;
      allow delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // Projekte: veröffentlichte sind für Lernende lesbar, sonst nur Besitzer:in
    match /projects/{id} {
      allow read: if (angemeldet() && alt().published == true)
        || (freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid);
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
      allow update: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
        && neu().ownerUid == alt().ownerUid;
      allow delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // Fortschritt der Lernenden (lernbereich.html meldet Lernende NICHT bei Firebase an):
    // ID = <Code>_<Aufgabe>. Schreiben nur für einen existierenden Schüler-Code, mit dessen
    // Lehrkraft, nur bekannte Felder, Text begrenzt; Code/Lehrkraft nachträglich unveränderbar.
    match /taskProgress/{progressId} {
      function gueltig() {
        let d = request.resource.data;
        let schueler = /databases/$(database)/documents/students/$(d.code);
        return d.keys().hasOnly(['code', 'ownerUid', 'taskId', 'status', 'submissionText', 'updatedAt'])
          && d.code is string && d.taskId is string
          && progressId == d.code + '_' + d.taskId
          && exists(schueler)
          && d.ownerUid == get(schueler).data.ownerUid
          && (!('status' in d) || d.status in ['offen', 'in_arbeit', 'fertig'])
          && (!('submissionText' in d) || (d.submissionText is string && d.submissionText.size() <= 20000))
          && (!('updatedAt' in d) || d.updatedAt is number);
      }
      allow get: if true;
      allow create: if gueltig();
      allow update: if gueltig()
        && request.resource.data.code == resource.data.code
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow list, delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // Kanban-Boards: Gruppen öffnen ihr Board mit dem Code
    match /boards/{code} {
      allow get: if angemeldet();
      allow list: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
      // Besitzer:in darf alles (außer den Besitz zu ändern), Gruppen nur ihr Board
      allow update: if (freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
                        && neu().ownerUid == alt().ownerUid)
        || (angemeldet() && geaendert().hasOnly(['columns', 'groupName', 'lastActive', 'feedback']));
      allow delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // =================================================================
    // Feedback, Bestenlisten, Aufrufzähler (protect.js, app.js, Cockpit)
    // =================================================================

    match /tool_feedback/{id} {
      allow create: if angemeldet() && nurFelder(['tool', 'vote', 'ts'])
        && istText(neu().tool, 120) && neu().vote in ['up', 'down'] && neu().ts is number;
      // Nur einmal einen kurzen Kommentar ergänzen
      allow update: if angemeldet() && geaendert().hasOnly(['comment'])
        && !('comment' in alt()) && istText(neu().comment, 140);
      allow read, delete: if istAdmin();
    }

    match /highscores/{id} {
      allow read: if true;
      allow create: if angemeldet() && nurFelder(['tool', 'name', 'score', 'ts'])
        && istText(neu().tool, 120)
        && neu().name is string && neu().name.size() > 0 && neu().name.size() <= 16
        && neu().score is number && neu().score >= 0 && neu().score <= 1000000
        && neu().ts is number;
      allow update: if false;
      allow delete: if istAdmin();
    }

    // Anonymer Tageszähler (ohne Kennung, ohne IP)
    match /page_views/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && neu().keys().hasOnly(['total', 'pages'])
        && neu().total == 1;
      allow update: if neu().keys().hasOnly(['total', 'pages'])
        && neu().total == alt().total + 1;
    }

    // =================================================================
    // Cockpit (nur das eigene Konto)
    // =================================================================
    match /cockpit/{uid}/{document=**} {
      allow read, write: if angemeldet() && request.auth.uid == uid;
    }

    // =================================================================
    // Strafenkasse (nur eingetragene Kassenwart:innen; Spieler-Ansicht
    // mit geheimem Link)
    // =================================================================
    match /strafenkasse/{team} {
      function sk_angemeldet() { return request.auth != null && request.auth.token.email_verified == true; }
      function sk_mail() { return request.auth.token.email.lower(); }
      allow get: if sk_angemeldet() && (resource == null || sk_mail() in resource.data.members);
      allow create: if sk_angemeldet() && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [sk_mail()];
      allow update: if sk_angemeldet() && sk_mail() in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.resource.data.members == resource.data.members
            || resource.data.owner == request.auth.uid);
      allow delete: if sk_angemeldet() && resource.data.owner == request.auth.uid;
    }
    match /strafenkasse_ansicht/{token} {
      function kassenwart(team) {
        return request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in get(/databases/$(database)/documents/strafenkasse/$(team)).data.members;
      }
      allow get: if true;
      allow list: if false;
      allow create: if kassenwart(request.resource.data.team);
      allow update: if kassenwart(resource.data.team) && request.resource.data.team == resource.data.team;
      allow delete: if kassenwart(resource.data.team);
    }

    // =================================================================
    // LernWerk
    // =================================================================
    match /lernwerk/{uid}/activities/{id} {
      allow read, write: if echtesKonto() && request.auth.uid == uid;
    }
    match /lernwerk_shared/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if angemeldet() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if angemeldet() && resource.data.owner == request.auth.uid
        && (request.method == 'delete' || request.resource.data.owner == resource.data.owner);
    }
    match /lernwerk_live/{code} {
      allow get: if angemeldet();
      allow create: if angemeldet() && request.resource.data.host == request.auth.uid;
      allow update, delete: if angemeldet() && resource.data.host == request.auth.uid;
      match /m/{msg} {
        allow create: if angemeldet() && request.resource.data.size() < 8;
        allow read: if angemeldet()
          && get(/databases/$(database)/documents/lernwerk_live/$(code)).data.host == request.auth.uid;
      }
    }

    // =================================================================
    // Blockwerk
    // =================================================================
    match /blockwerk/{uid}/worlds/{world} {
      allow read, write: if echtesKonto() && request.auth.uid == uid;
      match /parts/{part} {
        allow read, write: if echtesKonto() && request.auth.uid == uid;
      }
    }
    match /blockwerk_code/{code}/worlds/{world} {
      allow read, write: if angemeldet() && code.size() >= 12;
      match /parts/{part} {
        allow read, write: if angemeldet() && code.size() >= 12;
      }
    }
    match /blockwerk_vorlagen/{sid} {
      allow get: if true;
      allow list: if false;
      allow create: if echtesKonto() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if angemeldet() && resource.data.owner == request.auth.uid;
      match /parts/{part} {
        allow get: if true;
        allow write: if angemeldet()
          && get(/databases/$(database)/documents/blockwerk_vorlagen/$(sid)).data.owner == request.auth.uid;
      }
    }

    // Newsletter: läuft NICHT über Firestore (Google Apps Script) – nichts zu tun.
  }
}
