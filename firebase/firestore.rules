rules_version = '2';

// =====================================================================
// buildspace – Firestore-Sicherheitsregeln (Projekt kanban-board-281da)
// ---------------------------------------------------------------------
// Vollständige Regeln für ALLE Funktionen von buildspace. Werden nach
// jedem Push automatisch eingespielt (GitHub Action „Firestore-Regeln
// einspielen“). Nur hier ändern, nicht in der Konsole.
// Anleitung und Prüfliste: firebase/ANLEITUNG.md
//
// Grundsätze
// - Alles, was hier nicht ausdrücklich erlaubt ist, ist verboten.
// - „angemeldet()“ gilt auch für anonyme Sitzungen. Die bekommt JEDE
//   Besucherin automatisch – das ist also keine echte Hürde. Echte
//   Konten (Google) prüft „echtesKonto()“.
// - Lehrkräfte (Classroom Management) müssen von Marc freigeschaltet
//   sein (teachers/{uid}.status == "approved").
// - Codes (Schüler-Codes, Board-Codes) funktionieren wie Passwörter:
//   Einzelne Dokumente sind mit dem Code lesbar, Listen nie.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hilfsfunktionen ----------
    function angemeldet() { return request.auth != null; }
    function echtesKonto() {
      return angemeldet() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function istAdmin() {
      return echtesKonto()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'marcstroh11@googlemail.com';
    }
    function lehrkraftDoc() {
      return /databases/$(database)/documents/teachers/$(request.auth.uid);
    }
    function freigeschalteteLehrkraft() {
      return echtesKonto() && (istAdmin()
        || (exists(lehrkraftDoc()) && get(lehrkraftDoc()).data.status == 'approved'));
    }
    function neu() { return request.resource.data; }
    function alt() { return resource.data; }
    function nurFelder(felder) { return neu().keys().hasOnly(felder); }
    function geaendert() { return neu().diff(alt()).affectedKeys(); }
    function istText(v, max) { return v is string && v.size() <= max; }

    // =================================================================
    // Classroom Management (cm-auth.js, kurse-projekte.html,
    // lernbereich.html, kanban-board.html)
    // =================================================================

    // Warteliste/Freischaltung der Lehrkräfte. Niemand kann sich selbst
    // freischalten – nur Marc (Admin).
    match /teachers/{uid} {
      allow get: if angemeldet() && (request.auth.uid == uid || istAdmin());
      allow list: if istAdmin();
      allow create: if echtesKonto() && request.auth.uid == uid
        && nurFelder(['email', 'status', 'createdAt'])
        && neu().email == request.auth.token.email
        && (neu().status == 'pending' || (neu().status == 'approved' && istAdmin()));
      allow update, delete: if istAdmin();
    }

    // Klassen: nur die eigene Lehrkraft
    match /classes/{id} {
      allow read, update, delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
        && (request.method != 'update' || neu().ownerUid == alt().ownerUid);
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
    }

    // Lernende (nur Pseudonyme). Lernende melden sich mit ihrem Code an
    // (= Dokument-ID) und dürfen genau dieses eine Dokument lesen.
    match /students/{code} {
      allow get: if true;  // Lernbereich liest ohne Anmeldung
      allow list: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
      allow update: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
        && neu().ownerUid == request.auth.uid;
      allow delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // Projekte: veröffentlichte sind für Lernende lesbar, sonst nur Besitzer:in
    match /projects/{id} {
      allow read: if (angemeldet() && alt().published == true)
        || (freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid);
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
      allow update: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
        && neu().ownerUid == alt().ownerUid;
      allow delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // Fortschritt der Lernenden (lernbereich.html meldet Lernende NICHT bei Firebase an):
    // ID = <Code>_<Aufgabe>. Schreiben nur für einen existierenden Schüler-Code, mit dessen
    // Lehrkraft, nur bekannte Felder, Text begrenzt; Code/Lehrkraft nachträglich unveränderbar.
    match /taskProgress/{progressId} {
      function gueltig() {
        let d = request.resource.data;
        let schueler = /databases/$(database)/documents/students/$(d.code);
        return d.keys().hasOnly(['code', 'ownerUid', 'taskId', 'status', 'submissionText', 'updatedAt'])
          && d.code is string && d.taskId is string
          && progressId == d.code + '_' + d.taskId
          && exists(schueler)
          && d.ownerUid == get(schueler).data.ownerUid
          && (!('status' in d) || d.status in ['offen', 'in_arbeit', 'fertig'])
          && (!('submissionText' in d) || (d.submissionText is string && d.submissionText.size() <= 20000))
          && (!('updatedAt' in d) || d.updatedAt is number);
      }
      allow get: if true;
      allow create: if gueltig();
      allow update: if gueltig()
        && request.resource.data.code == resource.data.code
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow list, delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // Kanban-Boards: Gruppen öffnen ihr Board mit dem Code
    match /boards/{code} {
      allow get: if angemeldet();
      allow list: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
      allow create: if freigeschalteteLehrkraft() && neu().ownerUid == request.auth.uid;
      // Besitzer:in darf alles (außer den Besitz zu ändern), Gruppen nur ihr Board
      allow update: if (freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid
                        && neu().ownerUid == alt().ownerUid)
        || (angemeldet() && geaendert().hasOnly(['columns', 'groupName', 'lastActive', 'feedback']));
      allow delete: if freigeschalteteLehrkraft() && alt().ownerUid == request.auth.uid;
    }

    // =================================================================
    // Feedback, Bestenlisten, Aufrufzähler (protect.js, app.js, Cockpit)
    // =================================================================

    match /tool_feedback/{id} {
      allow create: if angemeldet() && nurFelder(['tool', 'vote', 'ts'])
        && istText(neu().tool, 120) && neu().vote in ['up', 'down'] && neu().ts is number;
      // Nur einmal einen kurzen Kommentar ergänzen
      allow update: if angemeldet() && geaendert().hasOnly(['comment'])
        && !('comment' in alt()) && istText(neu().comment, 140);
      allow read, delete: if istAdmin();
    }

    match /highscores/{id} {
      allow read: if true;
      allow create: if angemeldet() && nurFelder(['tool', 'name', 'score', 'ts'])
        && istText(neu().tool, 120)
        && neu().name is string && neu().name.size() > 0 && neu().name.size() <= 16
        && neu().score is number && neu().score >= 0 && neu().score <= 1000000
        && neu().ts is number;
      allow update: if false;
      allow delete: if istAdmin();
    }

    // Anonymer Tageszähler (ohne Kennung, ohne IP)
    match /page_views/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && neu().keys().hasOnly(['total', 'pages'])
        && neu().total == 1;
      allow update: if neu().keys().hasOnly(['total', 'pages'])
        && neu().total == alt().total + 1;
    }

    // =================================================================
    // Cockpit (nur das eigene Konto)
    // =================================================================
    match /cockpit/{uid}/{document=**} {
      allow read, write: if angemeldet() && request.auth.uid == uid;
    }

    // =================================================================
    // Strafenkasse (nur eingetragene Kassenwart:innen; Spieler-Ansicht
    // mit geheimem Link)
    // =================================================================
    match /strafenkasse/{team} {
      function sk_angemeldet() { return request.auth != null && request.auth.token.email_verified == true; }
      function sk_mail() { return request.auth.token.email.lower(); }
      allow get: if sk_angemeldet() && (resource == null || sk_mail() in resource.data.members);
      allow create: if sk_angemeldet() && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [sk_mail()];
      allow update: if sk_angemeldet() && sk_mail() in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.resource.data.members == resource.data.members
            || resource.data.owner == request.auth.uid);
      allow delete: if sk_angemeldet() && resource.data.owner == request.auth.uid;
    }
    match /strafenkasse_ansicht/{token} {
      function kassenwart(team) {
        return request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in get(/databases/$(database)/documents/strafenkasse/$(team)).data.members;
      }
      allow get: if true;
      allow list: if false;
      allow create: if kassenwart(request.resource.data.team);
      allow update: if kassenwart(resource.data.team) && request.resource.data.team == resource.data.team;
      allow delete: if kassenwart(resource.data.team);
    }

    // =================================================================
    // Hallendienst (hallendienst/index.html)
    // - Plan-ID im Link (20 Zeichen) = Lesezugang für die Mannschaft
    // - Eintragen/Austragen/Tausch mit anonymer Sitzung, nur eigene
    //   Einträge, Platzlimit, Frist und Sperre werden hier geprüft
    // - Verwaltung: Google-Konten in hallendienst_admin/{plan}.members
    //   (für Spieler:innen unsichtbar)
    // =================================================================
    // Eigenständige Hilfsfunktionen (Block kann einzeln eingespielt werden)
    function hd_angemeldet() { return request.auth != null; }
    function hd_konto() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true;
    }
    function hd_mail() { return request.auth.token.email.lower(); }
    function hd_neu() { return request.resource.data; }
    function hd_alt() { return resource.data; }
    function hd_nur(felder) { return hd_neu().keys().hasOnly(felder); }
    function hd_geaendert() { return hd_neu().diff(hd_alt()).affectedKeys(); }
    function hd_text(v, max) { return v is string && v.size() <= max; }
    function hd_adminDoc(plan) { return get(/databases/$(database)/documents/hallendienst_admin/$(plan)).data; }
    function hd_admin(plan) { return hd_konto() && hd_mail() in hd_adminDoc(plan).members; }
    function hd_owner(plan) { return hd_konto() && hd_adminDoc(plan).owner == request.auth.uid; }
    function hd_plan(plan) { return get(/databases/$(database)/documents/hallendienst/$(plan)).data; }
    function hd_dienst(plan, d) { return get(/databases/$(database)/documents/hallendienst/$(plan)/dienste/$(d)).data; }
    function hd_name(n) { return n is string && n.size() >= 1 && n.size() <= 40; }
    // persönliche Gutschrift (nur Verwaltung): fehlt oder 0,5 bis 20 Dienste
    function hd_wertOk() { return !('wert' in hd_neu()) || (hd_neu().wert is number && hd_neu().wert > 0 && hd_neu().wert <= 20); }

    match /hallendienst_admin/{plan} {
      allow get: if hd_konto() && (resource == null || hd_mail() in resource.data.members);
      allow list: if hd_konto() && hd_mail() in resource.data.members;
      allow create: if hd_konto() && plan.size() >= 16
        && !exists(/databases/$(database)/documents/hallendienst/$(plan))
        && hd_nur(['owner', 'ownerEmail', 'members', 'titel', 'erstellt'])
        && hd_neu().owner == request.auth.uid && hd_neu().members == [hd_mail()];
      allow update: if hd_konto() && hd_mail() in hd_alt().members
        && hd_neu().owner == hd_alt().owner && hd_neu().ownerEmail == hd_alt().ownerEmail
        && hd_neu().members is list && hd_neu().members.size() <= 10
        && (hd_neu().members == hd_alt().members || hd_alt().owner == request.auth.uid);
      allow delete: if hd_konto() && hd_alt().owner == request.auth.uid;
    }

    // Verweis Strafenkasse → Hallendienst, wenn die Verknüpfung im Hallendienst gesetzt wurde:
    // strafenkasse_hd/{token der Spieler-Ansicht} = { plan }. Lesen mit Token (wie die Spieler-Ansicht),
    // schreiben nur Admins des Plans, der genau diese Spieler-Ansicht verknüpft hat.
    match /strafenkasse_hd/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if hd_admin(hd_neu().plan)
        && hd_nur(['plan', 'at']) && hd_neu().plan is string
        && hd_plan(hd_neu().plan).get('strafenkasse', '').matches('^[A-Za-z0-9_-]*[|]' + token + '$');
      allow delete: if hd_admin(hd_alt().plan);
    }

    match /hallendienst/{plan} {
      allow get: if true;
      allow list: if false;
      allow create, update: if hd_admin(plan)
        && hd_nur(['titel', 'team', 'hinweis', 'spieler', 'frist', 'gesperrt', 'vorlage', 'checkliste', 'strafenkasse', 'rollen', 'erstellt', 'aktualisiert'])
        && hd_text(hd_neu().titel, 80) && hd_text(hd_neu().team, 60) && hd_text(hd_neu().hinweis, 500)
        && hd_text(hd_neu().get('checkliste', ''), 8000)
        && hd_text(hd_neu().get('strafenkasse', ''), 120)
        && hd_neu().get('rollen', {}) is map && hd_neu().get('rollen', {}).size() <= 80
        && hd_neu().frist is int && hd_neu().frist >= 0 && hd_neu().frist <= 336
        && hd_neu().gesperrt is bool
        && hd_neu().spieler is list && hd_neu().spieler.size() <= 80
        && hd_neu().vorlage is list && hd_neu().vorlage.size() <= 20;
      allow delete: if hd_owner(plan);

      match /dienste/{d} {
        allow read: if true;
        allow create, update: if hd_admin(plan) && hd_text(hd_neu().titel, 60)
          && hd_neu().plaetze is int && hd_neu().plaetze >= 1 && hd_neu().plaetze <= 20
          && hd_neu().start is timestamp;
        allow delete: if hd_admin(plan);
      }

      // Papierkorb: gelöschte Dienste samt Einträgen, 30 Tage wiederherstellbar (nur Verwaltung)
      match /archiv/{a} {
        allow read, delete: if hd_admin(plan);
        allow create, update: if hd_admin(plan)
          && hd_nur(['dienst', 'eintraege', 'geloescht', 'von'])
          && hd_neu().dienst is map && hd_neu().eintraege is list && hd_neu().eintraege.size() <= 40
          && hd_neu().geloescht == request.time;
      }

      // Ein Dokument pro belegtem Platz, ID = <dienst>_<platz>:
      // Doppelbelegung ist dadurch ausgeschlossen.
      match /eintraege/{e} {
        allow read: if true;
        allow create: if hd_angemeldet()
          && hd_nur(['dienst', 'platz', 'name', 'uid', 'tausch', 'at', 'wert'])
          && hd_neu().dienst is string && hd_neu().platz is int && hd_neu().platz >= 0
          && e == hd_neu().dienst + '_' + string(hd_neu().platz)
          && hd_neu().platz < hd_dienst(plan, hd_neu().dienst).plaetze
          && hd_name(hd_neu().name) && hd_neu().tausch == false && hd_neu().at == request.time
          && ((hd_neu().uid == request.auth.uid && hd_plan(plan).gesperrt != true
                && !('wert' in hd_neu())
                && request.time < hd_dienst(plan, hd_neu().dienst).start)
              || (hd_admin(plan) && hd_neu().uid is string && hd_wertOk()));
        allow update: if
          (hd_admin(plan) && hd_geaendert().hasOnly(['name', 'uid', 'tausch', 'at', 'wert'])
            && hd_name(hd_neu().name) && hd_neu().tausch is bool && hd_wertOk())
          || (hd_angemeldet() && hd_alt().uid == request.auth.uid
            && hd_geaendert().hasOnly(['tausch']) && hd_neu().tausch is bool)
          || (hd_angemeldet() && hd_alt().tausch == true && hd_neu().uid == request.auth.uid
            && hd_geaendert().hasOnly(['name', 'uid', 'tausch', 'at']) && hd_neu().tausch == false
            && hd_name(hd_neu().name) && hd_neu().at == request.time
            && request.time < hd_dienst(plan, hd_alt().dienst).start);
        allow delete: if hd_admin(plan)
          || (hd_angemeldet() && hd_alt().uid == request.auth.uid && hd_plan(plan).gesperrt != true
            && request.time < hd_dienst(plan, hd_alt().dienst).start
                              - duration.value(hd_plan(plan).frist, 'h'));
      }
    }

    // =================================================================
    // LernWerk
    // =================================================================
    match /lernwerk/{uid}/activities/{id} {
      allow read, write: if echtesKonto() && request.auth.uid == uid;
    }
    match /lernwerk_shared/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if angemeldet() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if angemeldet() && resource.data.owner == request.auth.uid
        && (request.method == 'delete' || request.resource.data.owner == resource.data.owner);
    }
    match /lernwerk_live/{code} {
      allow get: if angemeldet();
      allow create: if angemeldet() && request.resource.data.host == request.auth.uid;
      allow update, delete: if angemeldet() && resource.data.host == request.auth.uid;
      match /m/{msg} {
        allow create: if angemeldet() && request.resource.data.size() < 8;
        allow read: if angemeldet()
          && get(/databases/$(database)/documents/lernwerk_live/$(code)).data.host == request.auth.uid;
      }
    }

    // =================================================================
    // Blockwerk
    // =================================================================
    match /blockwerk/{uid}/worlds/{world} {
      allow read, write: if echtesKonto() && request.auth.uid == uid;
      match /parts/{part} {
        allow read, write: if echtesKonto() && request.auth.uid == uid;
      }
    }
    match /blockwerk_code/{code}/worlds/{world} {
      allow read, write: if angemeldet() && code.size() >= 12;
      match /parts/{part} {
        allow read, write: if angemeldet() && code.size() >= 12;
      }
    }
    match /blockwerk_vorlagen/{sid} {
      allow get: if true;
      allow list: if false;
      allow create: if echtesKonto() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if angemeldet() && resource.data.owner == request.auth.uid;
      match /parts/{part} {
        allow get: if true;
        allow write: if angemeldet()
          && get(/databases/$(database)/documents/blockwerk_vorlagen/$(sid)).data.owner == request.auth.uid;
      }
    }

    // =================================================================
    // Geoheft (geoheft.html) – nur das eigene Google-Konto
    //   geoheft/{uid}                        Seitenreihenfolge, Maßstab
    //   geoheft/{uid}/pages/{seite}          Kopfdaten einer Seite
    //   geoheft/{uid}/pages/{seite}/parts|bg Zeichnung bzw. Hintergrund in Stücken
    // =================================================================
    match /geoheft/{uid} {
      allow read, write: if echtesKonto() && request.auth.uid == uid;
      match /pages/{seite} {
        allow read, write: if echtesKonto() && request.auth.uid == uid;
        match /{teil}/{n} {
          allow read, write: if echtesKonto() && request.auth.uid == uid
            && teil in ['parts', 'bg'];
        }
      }
    }

    // =================================================================
    // Kabine (kabine/index.html) – Training, Spiele, Termine
    // - Mannschafts-ID im Link (20 Zeichen) = Lesezugang
    // - Zu-/Absagen, Aufgaben, Abwesenheiten, Pinnwand mit anonymer
    //   Sitzung; Frist, Mitgliedschaft und Felder werden hier geprüft
    // - Verwaltung: Google-Konten in kabine_admin/{team}.members
    // =================================================================
    function kb_angemeldet() { return request.auth != null; }
    function kb_konto() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true;
    }
    function kb_mail() { return request.auth.token.email.lower(); }
    function kb_neu() { return request.resource.data; }
    function kb_alt() { return resource.data; }
    function kb_nur(felder) { return kb_neu().keys().hasOnly(felder); }
    function kb_geaendert() { return kb_neu().diff(kb_alt()).affectedKeys(); }
    function kb_text(v, max) { return v is string && v.size() <= max; }
    function kb_datum(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function kb_adminDoc(team) { return get(/databases/$(database)/documents/kabine_admin/$(team)).data; }
    function kb_admin(team) { return kb_konto() && kb_mail() in kb_adminDoc(team).members; }
    function kb_owner(team) { return kb_konto() && kb_adminDoc(team).owner == request.auth.uid; }
    function kb_team(team) { return get(/databases/$(database)/documents/kabine/$(team)).data; }
    function kb_termin(team, t) { return get(/databases/$(database)/documents/kabine/$(team)/termine/$(t)).data; }
    function kb_mitglied(team, id) { return id is string && id in kb_team(team).mitglieder; }
    // Spieler:innen dürfen bis zur Antwortfrist antworten (nicht bei abgesagten Terminen oder gesperrter Mannschaft)
    function kb_offen(team, t) {
      return kb_termin(team, t).get('abgesagt', false) != true
        && kb_team(team).get('gesperrt', false) != true
        && request.time < kb_termin(team, t).fristBis;
    }

    match /kabine_admin/{team} {
      allow get: if kb_konto() && (resource == null || kb_mail() in resource.data.members);
      allow list: if kb_konto() && kb_mail() in resource.data.members;
      allow create: if kb_konto() && team.size() >= 16
        && !exists(/databases/$(database)/documents/kabine/$(team))
        && kb_nur(['owner', 'ownerEmail', 'members', 'titel', 'erstellt'])
        && kb_neu().owner == request.auth.uid && kb_neu().ownerEmail == kb_mail()
        && kb_neu().members == [kb_mail()] && kb_text(kb_neu().titel, 80);
      allow update: if kb_konto() && kb_mail() in kb_alt().members
        && kb_neu().owner == kb_alt().owner && kb_neu().ownerEmail == kb_alt().ownerEmail
        && kb_neu().members is list && kb_neu().members.size() <= 10 && kb_alt().ownerEmail in kb_neu().members
        && (kb_neu().members == kb_alt().members || kb_alt().owner == request.auth.uid)
        && kb_text(kb_neu().get('titel', ''), 80);
      allow delete: if kb_konto() && kb_alt().owner == request.auth.uid;
    }

    // Rückverweis Hallendienst → Kabine: kabine_hd/{plan} = { team, titel }.
    // Schreiben nur die Admins einer Mannschaft, die genau diesen Plan verknüpft hat.
    match /kabine_hd/{plan} {
      allow get: if true;
      allow list: if false;
      allow create, update: if kb_nur(['team', 'titel', 'at']) && kb_neu().team is string
        && kb_admin(kb_neu().team) && kb_team(kb_neu().team).get('hallendienst', '') == plan
        && kb_text(kb_neu().titel, 60);
      allow delete: if kb_admin(kb_alt().team);
    }

    match /kabine/{team} {
      allow get: if true;
      allow list: if false;
      allow create, update: if kb_admin(team)
        && kb_nur(['titel', 'verein', 'hinweis', 'saisonStart', 'mitglieder', 'einst', 'hallendienst', 'strafenkasse', 'anwurf', 'gesperrt', 'erstellt', 'aktualisiert'])
        && kb_text(kb_neu().titel, 80) && kb_text(kb_neu().get('verein', ''), 80) && kb_text(kb_neu().get('hinweis', ''), 600)
        && kb_text(kb_neu().get('hallendienst', ''), 60) && kb_text(kb_neu().get('strafenkasse', ''), 120)
        && kb_text(kb_neu().get('saisonStart', ''), 10)
        && kb_neu().mitglieder is map && kb_neu().mitglieder.size() <= 80
        && kb_neu().get('einst', {}) is map
        && kb_neu().get('gesperrt', false) is bool;
      allow delete: if kb_owner(team);

      // Termine: nur die Verwaltung
      match /termine/{t} {
        allow read: if true;
        allow create, update: if kb_admin(team)
          && kb_nur(['typ', 'titel', 'datum', 'von', 'bis', 'treff', 'ort', 'adresse', 'gegner', 'heim', 'notiz', 'frist', 'fristBis', 'start',
                     'max', 'kader', 'standard', 'pflicht', 'fahrten', 'aufgaben', 'anwesenheit', 'abgesagt', 'absageGrund', 'serie',
                     'quelle', 'quelleZeit', 'ergebnis', 'strafen', 'erstellt', 'aktualisiert'])
          && kb_neu().typ in ['training', 'spiel', 'event']
          && kb_text(kb_neu().titel, 80) && kb_datum(kb_neu().datum)
          && kb_neu().start is timestamp && kb_neu().fristBis is timestamp
          && kb_text(kb_neu().get('notiz', ''), 2000) && kb_text(kb_neu().get('ort', ''), 120)
          && kb_neu().get('aufgaben', {}) is map && kb_neu().get('aufgaben', {}).size() <= 10
          && kb_neu().get('kader', []) is list && kb_neu().get('kader', []).size() <= 80
          && kb_neu().get('anwesenheit', {}) is map && kb_neu().get('anwesenheit', {}).size() <= 100
          && kb_neu().get('strafen', []) is list && kb_neu().get('strafen', []).size() <= 300;
        allow delete: if kb_admin(team);
      }

      // Zu-/Absagen: ID = <termin>_<mitglied>
      match /antworten/{a} {
        allow read: if true;
        allow create, update: if kb_angemeldet()
          && kb_nur(['termin', 'spieler', 'status', 'grund', 'auto', 'mitfahrt', 'start', 'uid', 'at', 'von'])
          && kb_neu().termin is string && a == kb_neu().termin + '_' + kb_neu().spieler
          && kb_neu().status in ['ja', 'nein', 'vielleicht']
          && kb_text(kb_neu().get('grund', ''), 140) && kb_text(kb_neu().get('von', ''), 60)
          && kb_neu().get('auto', 0) is int && kb_neu().get('auto', 0) >= 0 && kb_neu().get('auto', 0) <= 8
          && kb_neu().get('mitfahrt', false) is bool
          && kb_neu().uid == request.auth.uid && kb_neu().at == request.time
          && kb_mitglied(team, kb_neu().spieler)
          && kb_neu().start == kb_termin(team, kb_neu().termin).start
          && (kb_admin(team) || kb_offen(team, kb_neu().termin));
        allow delete: if kb_admin(team) || (kb_angemeldet() && kb_offen(team, kb_alt().termin));
      }

      // Aufgaben (Fahrdienst, Trikots …): ID = <termin>_<aufgabe>_<platz>
      match /aufgaben/{u} {
        allow read: if true;
        allow create: if kb_angemeldet()
          && kb_nur(['termin', 'aufgabe', 'platz', 'spieler', 'name', 'start', 'uid', 'at'])
          && kb_neu().termin is string && kb_neu().aufgabe is string && kb_neu().platz is int && kb_neu().platz >= 0
          && u == kb_neu().termin + '_' + kb_neu().aufgabe + '_' + string(kb_neu().platz)
          && kb_neu().platz < kb_termin(team, kb_neu().termin).aufgaben[kb_neu().aufgabe].plaetze
          && kb_mitglied(team, kb_neu().spieler) && kb_text(kb_neu().name, 40)
          && kb_neu().uid == request.auth.uid && kb_neu().at == request.time
          && kb_neu().start == kb_termin(team, kb_neu().termin).start
          && (kb_admin(team) || kb_termin(team, kb_neu().termin).get('abgesagt', false) != true);
        allow update: if kb_admin(team) && kb_geaendert().hasOnly(['start', 'uid', 'at', 'name', 'spieler'])
          && kb_mitglied(team, kb_neu().spieler) && kb_neu().start == kb_termin(team, kb_neu().termin).start;
        allow delete: if kb_admin(team) || (kb_angemeldet() && request.time < kb_termin(team, kb_alt().termin).start);
      }

      match /abwesenheiten/{id} {
        allow read: if true;
        allow create, update: if kb_angemeldet()
          && kb_nur(['spieler', 'von', 'bis', 'grund', 'uid', 'at'])
          && kb_mitglied(team, kb_neu().spieler) && kb_datum(kb_neu().von) && kb_datum(kb_neu().bis)
          && kb_neu().von <= kb_neu().bis && kb_text(kb_neu().grund, 80)
          && kb_neu().uid == request.auth.uid && kb_neu().at == request.time;
        allow delete: if kb_angemeldet();
      }

      // Pinnwand mit Umfragen
      match /posts/{p} {
        allow read: if true;
        allow create: if kb_angemeldet()
          && kb_nur(['text', 'autor', 'spieler', 'uid', 'at', 'wichtig', 'umfrage'])
          && kb_text(kb_neu().text, 2000) && kb_text(kb_neu().autor, 40) && kb_neu().autor.size() > 0 && kb_text(kb_neu().spieler, 30)
          && kb_neu().uid == request.auth.uid && kb_neu().at == request.time
          && kb_neu().wichtig is bool && (kb_neu().wichtig == false || kb_admin(team))
          && (kb_team(team).get('einst', {}).get('postsNur', false) != true || kb_admin(team))
          && (kb_neu().umfrage == null || (kb_neu().umfrage is map && kb_text(kb_neu().umfrage.frage, 200)
              && kb_neu().umfrage.optionen is list && kb_neu().umfrage.optionen.size() >= 2 && kb_neu().umfrage.optionen.size() <= 10));
        allow update: if (kb_admin(team) && kb_geaendert().hasOnly(['wichtig', 'umfrage', 'text']) && kb_text(kb_neu().text, 2000))
          || (kb_angemeldet() && kb_alt().uid == request.auth.uid && kb_geaendert().hasOnly(['text']) && kb_text(kb_neu().text, 2000));
        allow delete: if kb_admin(team) || (kb_angemeldet() && kb_alt().uid == request.auth.uid);
      }
      match /kommentare/{k} {
        allow read: if true;
        allow create: if kb_angemeldet()
          && kb_nur(['post', 'text', 'autor', 'spieler', 'uid', 'at'])
          && kb_neu().post is string && kb_text(kb_neu().text, 500) && kb_neu().text.size() > 0
          && kb_text(kb_neu().autor, 40) && kb_mitglied(team, kb_neu().spieler)
          && kb_neu().uid == request.auth.uid && kb_neu().at == request.time;
        allow delete: if kb_admin(team) || (kb_angemeldet() && kb_alt().uid == request.auth.uid);
      }
      // Stimmen: ID = <post>_<mitglied>
      match /stimmen/{st} {
        allow read: if true;
        allow create, update: if kb_angemeldet()
          && kb_nur(['post', 'spieler', 'wahl', 'uid', 'at'])
          && st == kb_neu().post + '_' + kb_neu().spieler
          && kb_mitglied(team, kb_neu().spieler)
          && kb_neu().wahl is list && kb_neu().wahl.size() >= 1 && kb_neu().wahl.size() <= 10
          && kb_neu().uid == request.auth.uid && kb_neu().at == request.time;
        allow delete: if kb_angemeldet();
      }
    }

    // Newsletter: läuft NICHT über Firestore (Google Apps Script) – nichts zu tun.
  }
}
